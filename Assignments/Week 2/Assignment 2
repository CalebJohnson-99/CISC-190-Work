```java
import java.util.Scanner;

public class ScoreAnalyzer {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        int validScoresCount = 0;
        double totalValidScores = 0.0;
        double highestScore = 0.0;
        double lowestScore = 0.0;
        int passingScoresCount = 0;
        int belowSixtyCount = 0;

        System.out.print("Enter a score from 0 to 100 (-1 to finish): ");
        double score = input.nextDouble();

        while (score != -1) {

            if (score >= 0 && score <= 100) {

                validScoresCount++;
                totalValidScores += score;

                if (score > highestScore) {
                    highestScore = score;
                }
                if (score < lowestScore) {
                    lowestScore = score;
                }
                if (score >= 60) {
                    passingScoresCount++;
                }
                else {
                    belowSixtyCount++;
                }
            }
            else {
                System.out.println("Invalid score. Value ignored.");
            }

            System.out.print("Enter a score from 0 to 100 (-1 to finish): ");
            score = input.nextDouble();
        }
        System.out.println("----- Score Summary -----");

        if (validScoresCount > 0) {
            double averageScore = totalValidScores / validScoresCount;

            System.out.println("Valid scores: " + validScoresCount);
            System.out.printf("Average: ", + averageScore);
            System.out.printf("Highest: ", + highestScore);
            System.out.printf("Lowest: ", + lowestScore);
            System.out.println("Passing scores: " + passingScoresCount);
            System.out.println("Below 60: " + belowSixtyCount);
        }
    }
}
```

